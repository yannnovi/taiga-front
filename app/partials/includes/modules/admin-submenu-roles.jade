section.admin-submenu.admin-submenu-roles(ng-if="roles")
    nav
        ul
            li(
                ng-repeat="item in roles",
                ng-class="{active: role.id == item.id}"
            )
                a(
                    href=""
                    ng-click="ctrl.setRole(item)"
                )
                  span.single-role {{ item.name }}

        tg-new-role(
            bind-roles="roles"
            bind-project-id="projectId"
            on-created="ctrl.setRole($event); ctrl.forceLoadProject()"
        )
