doctype html

tg-project-archived-warning
div.wrapper(
    ng-controller="EpicDetailController as ctrl",
    ng-init="section='epics'"
)
    tg-project-menu

    div.main.detail
        .detail-header-container(ng-class="{blocked: epic.is_blocked}")
            tg-detail-nav(bind-item="epic")
            .detail-header
                tg-detail-header(
                    item="epic"
                    section-name="sectionName"
                    project="project"
                    required-perm="modify_epic"
                    ng-if="project && epic"
                    format="text"
                )
                .epic-selector
                    span.epic-selector-text {{'EPIC.EPIC_COLOR' | translate}}
                    tg-color-selector.color-selector(
                        bind-is-color-required="true"
                        bind-init-color="epic.color"
                        on-select-color="ctrl.onSelectColor($event.color)"
                        required-perm="modify_epic"
                    )
                .subheader
                    tg-tag-line.tags-block(
                        ng-if="epic && project"
                        bind-project="project"
                        bind-item="epic"
                        permissions="modify_epic"
                    )
                    tg-detail-created-by.ticket-created-by(bind-item="epic")


        .detail-content(ng-if="attachmentsReady")
            section.duty-content
                tg-item-wysiwyg(
                    type="epic",
                    model="epic",
                    required-perm="modify_epic"
                )

            // Custom Fields
            tg-custom-attributes-values(
                bind-object="epic"
                bind-type="'epic'"
                bind-project="project"
                bind-required-edition-perm="'modify_epic'"
            )

            tg-attachments-full(
                obj-id="epic.id"
                type="epic",
                project-id="projectId"
                edit-permission = "modify_epic"
            )

            tg-related-userstories(
                project="immutableProject"
                userstories="userstories"
                epic="immutableEpic"
            )

            tg-history-section(
                ng-if="epic"
                type="epic"
                name="epic"
                id="epic.id"
                project="project"
            )

    sidebar.sidebar.ticket-data

        section.ticket-header
            tg-detail-status-display.ticket-title(
                bind-item="epic"
                bind-status-list="statusList"
            )
            tg-detail-status-button.detail-status(
                bind-item="epic"
                bind-status-list="statusList"
                bind-project="project"
                permission="modify_epic"
            )

        section.ticket-section.ticket-assigned-to(
            tg-assigned-to
            ng-model="epic"
            required-perm="modify_epic"
        )

        section.ticket-section.ticket-watchers(
            tg-watchers
            item="epic"
            active-users="activeUsers"
            on-watch="ctrl.onWatch"
            on-unwatch="ctrl.onUnwatch"
            required-perm="modify_epic"
        )

        section.ticket-section.ticket-detail-settings
            tg-detail-requirement-button(bind-item="epic" bind-project="project" kind="team")
            tg-detail-requirement-button(bind-item="epic" bind-project="project" kind="client")
            tg-detail-block-button(
                tg-check-permission="modify_epic"
                bind-item="epic"
                bind-project="project"
            )
            tg-detail-delete-button(
                tg-check-permission="delete_epic"
                delete-title="{{'EPIC.ACTION_DELETE' | translate}}"
                bind-go-to-url="onDeleteGoToUrl"
                bind-item="epic"
            )

    tg-lb-block.lightbox.lightbox-block(bind-item="epic", lb-title="EPIC.LIGHTBOX_TITLE_BLOKING_EPIC")
