doctype html

div.wrapper(ng-controller="ProjectValuesSectionController",
            ng-init="section='admin'; sectionName='ADMIN.PROJECT_VALUES_STATUS.TITLE'")

    tg-project-menu

    sidebar.menu-secondary.sidebar.settings-nav(tg-admin-navigation="project-values")
        include ../includes/modules/admin-menu

    sidebar.menu-tertiary.sidebar(tg-admin-navigation="values-status")
        include ../includes/modules/admin-submenu-project-values

    section.main.admin-common.admin-attributes
        include ../includes/components/mainTitle
        p.admin-subtitle(translate="ADMIN.PROJECT_VALUES_STATUS.SUBTITLE")

        tg-project-values-status.admin-attributes-section(
            bind-project="project"
            bind-resource="'epics'"
            bind-type="'epic-statuses'"
            bind-obj-name="'status'"
            bind-section-title-key="'ADMIN.PROJECT_VALUES_STATUS.EPIC_TITLE'"
        )

        tg-project-values-us-status.admin-attributes-section(
            bind-project="project"
            bind-resource="'userstories'"
            bind-type="'userstory-statuses'"
            bind-obj-name="'status'"
            bind-section-title-key="'ADMIN.PROJECT_VALUES_STATUS.US_TITLE'"
        )

        tg-project-values-status.admin-attributes-section(
            bind-project="project"
            bind-resource="'tasks'"
            bind-type="'task-statuses'"
            bind-obj-name="'status'"
            bind-section-title-key="'ADMIN.PROJECT_VALUES_STATUS.TASK_TITLE'"
        )

        tg-project-values-status.admin-attributes-section(
            bind-project="project"
            bind-resource="'issues'"
            bind-type="'issue-statuses'"
            bind-obj-name="'status'"
            bind-section-title-key="'ADMIN.PROJECT_VALUES_STATUS.ISSUE_TITLE'"
        )
