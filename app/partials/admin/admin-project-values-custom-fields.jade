doctype html

div.wrapper(
    ng-controller="ProjectValuesSectionController",
    ng-init="sectionName='ADMIN.CUSTOM_FIELDS.TITLE'"
)

    tg-project-menu

    sidebar.menu-secondary.sidebar.settings-nav(tg-admin-navigation="project-values")
        include ../includes/modules/admin-menu

    sidebar.menu-tertiary.sidebar(tg-admin-navigation="values-custom-fields")
        include ../includes/modules/admin-submenu-project-values

    section.main.admin-common.admin-attributes
        include ../includes/components/mainTitle
        p.admin-subtitle(translate="ADMIN.CUSTOM_FIELDS.SUBTITLE")

        tg-project-custom-attributes-table.admin-attributes-section(
            bind-project="project"
            bind-type="'epic'"
            bind-section-title-key="'ADMIN.CUSTOM_FIELDS.EPIC_DESCRIPTION'"
            bind-add-button-title-key="'ADMIN.CUSTOM_FIELDS.EPIC_ADD'"
        )

        tg-project-custom-attributes-table.admin-attributes-section(
            bind-project="project"
            bind-type="'userstory'"
            bind-section-title-key="'ADMIN.CUSTOM_FIELDS.US_DESCRIPTION'"
            bind-add-button-title-key="'ADMIN.CUSTOM_FIELDS.US_ADD'"
        )

        tg-project-custom-attributes-table.admin-attributes-section(
            bind-project="project"
            bind-type="'task'"
            bind-section-title-key="'ADMIN.CUSTOM_FIELDS.TASK_DESCRIPTION'"
            bind-add-button-title-key="'ADMIN.CUSTOM_FIELDS.TASK_ADD'"
        )

        tg-project-custom-attributes-table.admin-attributes-section(
            bind-project="project"
            bind-type="'issue'"
            bind-section-title-key="'ADMIN.CUSTOM_FIELDS.ISSUE_DESCRIPTION'"
            bind-add-button-title-key="'ADMIN.CUSTOM_FIELDS.ISSUE_ADD'"
        )
