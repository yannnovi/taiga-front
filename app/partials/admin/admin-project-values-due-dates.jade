doctype html

div.wrapper(ng-controller="ProjectValuesSectionController",
            ng-init="sectionName='ADMIN.PROJECT_DUE_DATE_STATUS.TITLE'")

    tg-project-menu

    sidebar.menu-secondary.sidebar.settings-nav(tg-admin-navigation="project-values")
        include ../includes/modules/admin-menu

    sidebar.menu-tertiary.sidebar(tg-admin-navigation="values-due-dates")
        include ../includes/modules/admin-submenu-project-values

    section.main.admin-common.admin-attributes
        include ../includes/components/mainTitle
        p.admin-subtitle(translate="ADMIN.PROJECT_DUE_DATE_STATUS.SUBTITLE")

        tg-project-values-due-dates.admin-attributes-section(
            bind-project="project"
            bind-resource="'userstories'"
            bind-type="'userstory-due-dates'"
            bind-obj-name="'status'"
            bind-section-title-key="'ADMIN.PROJECT_DUE_DATE_STATUS.US_TITLE'"
        )

        tg-project-values-due-dates.admin-attributes-section(
            bind-project="project"
            bind-resource="'tasks'"
            bind-type="'task-due-dates'"
            bind-obj-name="'status'"
            bind-section-title-key="'ADMIN.PROJECT_DUE_DATE_STATUS.TASK_TITLE'"
        )

        tg-project-values-due-dates.admin-attributes-section(
            bind-project="project"
            bind-resource="'issues'"
            bind-type="'issue-due-dates'"
            bind-obj-name="'status'"
            bind-section-title-key="'ADMIN.PROJECT_DUE_DATE_STATUS.ISSUE_TITLE'"
        )
