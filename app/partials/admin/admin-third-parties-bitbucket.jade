doctype html

div.wrapper.roles(
    ng-controller="BitbucketController as ctrl",
    ng-init="section='admin'"
)
    tg-project-menu

    sidebar.menu-secondary.sidebar.settings-nav(tg-admin-navigation="third-parties")
        include ../includes/modules/admin-menu
    sidebar.menu-tertiary.sidebar(tg-admin-navigation="third-parties-bitbucket")
        include ../includes/modules/admin-submenu-third-parties

    section.main.admin-common.admin-third-parties
        include ../includes/components/mainTitle

        tg-third-party-webhook-form(
            bind-module="bitbucket"
            bind-provider="'bitbucket'"
            bind-has-valid-origin-ips="true"
            bind-valid-origin-ips-placeholder-key="'ADMIN.BITBUCKET.INFO_VERIFYING_IP'"
            bind-help-url="'https://docs.taiga.io/integrations-bitbucket.html'"
            on-reload="ctrl.loadModules()"
        )
