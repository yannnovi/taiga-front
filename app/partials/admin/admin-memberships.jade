doctype html

tg-project-archived-warning
div.wrapper.memberships(
    ng-controller="MembershipsController as ctrl"
    ng-init="section='admin'; sectionName='ADMIN.MEMBERSHIPS.TITLE'"
)
    tg-project-menu

    sidebar.menu-secondary.sidebar.settings-nav(tg-admin-navigation="memberships")
        include ../includes/modules/admin-menu

    section.main.admin-membership.admin-common
        .header-with-actions
            header
                include ../includes/components/mainTitle
                .header-message(ng-if="canAddUsers == false")
                    tg-no-more-memberships-explanation(bind-project="project", bind-owner-email="projectOwnerEmail")

            .action-buttons(
                    ng-if="canAddUsers == true"
                )
                button.btn-small(
                    variant="primary"
                    translate="ADMIN.MEMBERSHIPS.ADD_BUTTON"
                    title="{{ ADMIN.MEMBERSHIPS.ADD_BUTTON_TITLE | translate }}",
                    ng-click="ctrl.addNewMembers()"
                )

        tg-memberships-table(
            bind-memberships="memberships"
            bind-project="project"
            bind-page="page"
            bind-count="count"
            bind-paginated-by="paginatedBy"
            on-page-change="ctrl.selectFilter('page', $event); ctrl.loadMembers()"
            on-reload="$event ? ctrl.selectFilter('page', $event) : null; ctrl.loadInitialData()"
        )
