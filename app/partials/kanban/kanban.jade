doctype html

tg-project-archived-warning
div.wrapper(
    ng-controller="KanbanController as ctrl"
    ng-init="section='kanban'"
)
    tg-project-menu

    section.main.kanban(ng-class="{ 'swimlane': swimlanesList.size }")
        .kanban-header
            include ../includes/components/mainTitle
            .taskboard-actions
                .kanban-table-options-start
                    button.btn-filter.e2e-open-filter(
                        ng-click="ctrl.openFilter = !ctrl.openFilter"
                        title="{{ctrl.selectedFilters.length}} {{'COMMON.FILTERS.APPLIED_FILTERS_NUM' | translate}}"
                        ng-class="{active: ctrl.openFilter}"
                    )
                        tg-svg(svg-icon="icon-filters")
                        span.text(
                            ng-if="!ctrl.openFilter"
                            translate="BACKLOG.FILTERS.TITLE"
                        )
                        span.text(
                            ng-if="ctrl.openFilter"
                            translate="BACKLOG.FILTERS.HIDE_TITLE"
                        )
                        span.selected-filters(ng-if="ctrl.selectedFilters.length") {{ctrl.selectedFilters.length}}

                    tg-input-search(
                        bind-q="ctrl.filterQ"
                        on-change="ctrl.changeQ($event.q)"
                    )

                .kanban-table-options-end
                    tg-kanban-board-zoom(
                        on-zoom-change="ctrl.setZoom($event.zoomLevel, $event.zoom)"
                    )

        .kanban-manager(ng-class="{'expanded': !ctrl.openFilter}")
            .kanban-filter(
                ng-if="ctrl.openFilter"
            )
                tg-filter(
                    filters="ctrl.filters"
                    custom-filters="ctrl.customFilters"
                    selected-filters="ctrl.selectedFilters"
                    customFilters="ctl.customFilters"
                    on-save-custom-filter="ctrl.saveCustomFilter(name)"
                    on-add-filter="ctrl.addFilter(filter)"
                    on-select-custom-filter="ctrl.selectCustomFilter(filter)"
                    on-remove-custom-filter="ctrl.removeCustomFilter(filter)"
                    on-remove-filter="ctrl.removeFilter(filter)"
                )

            tg-kanban-sortable(
                ng-if="ctrl.initialLoad"
                bind-project="project"
                bind-project-id="projectId"
                bind-zoom="ctrl.zoom"
                bind-zoom-level="ctrl.zoomLevel"
                bind-us-status-list="usStatusList"
                bind-swimlanes-list="swimlanesList"
                bind-swimlanes-statuses="swimlanesStatuses"
                bind-us-by-status="usByStatus"
                bind-us-by-status-swimlanes="usByStatusSwimlanes"
                bind-us-map="usMap"
                bind-folded-swimlane="ctrl.foldedSwimlane"
                bind-not-found-userstories="ctrl.notFoundUserstories"
                bind-moved-us="ctrl.movedUs"
                bind-render-in-progress="ctrl.renderInProgress"
                bind-get-card-link-params="ctrl.getCardLinkParams"
                bind-selected-uss="ctrl.selectedUss"
                on-toggle-fold="ctrl.toggleFold($event.id)"
                on-edit-us="ctrl.editUs($event.id)"
                on-delete-us="ctrl.deleteUs($event.id)"
                on-change-us-assigned-users="ctrl.changeUsAssignedUsers($event.id)"
                on-click-move-to-top="ctrl.moveToTopDropdown(usMap.get($event.id))"
                on-add-new-us="ctrl.addNewUs($event.type, $event.statusId)"
                on-toggle-swimlane="ctrl.toggleSwimlane($event.id)"
                on-toggle-selected-us="ctrl.toggleSelectedUs($event.id)"
                on-reorder="ctrl.moveUs(null, $event.usList, $event.newStatusId, $event.newSwimlaneId, $event.index, $event.previousCard, $event.nextCard)"
            )

    div.lightbox.lightbox-generic-form.lightbox-create-edit(tg-lb-create-edit)

    div.lightbox.lightbox-generic-bulk(tg-lb-create-bulk-userstories)
        include ../includes/modules/lightbox-us-bulk
