.tags-container
    .tag-wrapper(
        ng-if="tag[1] && !vm.disableColorSelection"
        ng-repeat="tag in vm.tags"
    )
        tg-tag(
            bind-tag="tag"
            bind-loading-remove-tag="vm.loadingRemoveTag"
            on-delete-tag="vm.onDeleteTag($event.tag)"
            bind-has-permissions="vm.checkPermissions()"
            bind-is-archived="vm.isArchived()"
        )
    .tag-wrapper(
        ng-if="!tag[1] || vm.disableColorSelection"
        ng-repeat="tag in vm.tags"
    )
        tg-tag(
            bind-tag="tag"
            bind-loading-remove-tag="vm.loadingRemoveTag"
            on-delete-tag="vm.onDeleteTag($event.tag)"
            bind-has-permissions="vm.checkPermissions()"
            bind-is-archived="vm.isArchived()"
        )

    include ../components/add-tag-button
    include ../components/add-tag-input
